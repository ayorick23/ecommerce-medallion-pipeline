# Copia este archivo a .env (fuera de git) y completa lo que uses.
# docker compose lo lee solo; si no existe, el compose funciona igual.

# UID con el que corren los contenedores. En Linux, `id -u`, para que los
# archivos que escribe el pipeline en data/ y logs/ sean tuyos. En Windows y
# macOS (Docker Desktop) se puede dejar como está.
AIRFLOW_UID=50000

# Usuario de la UI de Airflow (http://localhost:8080).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Pipeline (opcionales). Sin definir, se usa config/pipeline.yaml tal cual.
# Ojo: el compose pasa este archivo a los contenedores. La imagen ya define
# PIPELINE_CONFIG con una ruta absoluta; una relativa aquí rompería el DAG.
# PIPELINE_CONFIG=config/pipeline.yaml
# PIPELINE_STORAGE_ROOT=./data

# --- Alertas por correo (ADR 0042) -----------------------------------------
# Apagadas en config/pipeline.yaml. Para activarlas, descomenta la línea de
# abajo y completa TODAS las demás: si falta alguna, el DAG no carga.
# PIPELINE_ALERTS_ENABLED=true
PIPELINE_ALERT_EMAIL=

# SMTP de Airflow. Con Gmail: smtp.gmail.com, 587 y una contraseña de
# aplicación (requiere verificación en dos pasos), no tu contraseña normal.
AIRFLOW__SMTP__SMTP_HOST=
AIRFLOW__SMTP__SMTP_PORT=
AIRFLOW__SMTP__SMTP_USER=
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_MAIL_FROM=
