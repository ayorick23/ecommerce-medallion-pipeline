# Copiar a .env y ajustar si hace falta. .env nunca se versiona.

# Credenciales del usuario admin de Airflow (creado por el servicio airflow-init)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Pipeline (opcionales). Sin definir, se usa config/pipeline.yaml tal cual.
# PIPELINE_CONFIG=config/pipeline.yaml
# PIPELINE_STORAGE_ROOT=./data
